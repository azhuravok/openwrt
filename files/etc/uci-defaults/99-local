#!/bin/sh
# Personal defaults for this WAP4410N. uci-defaults run once after every
# flash (also when settings were kept) and after a factory reset – so only
# replace the factory LAN default, never a configuration restored from
# sysupgrade.tgz or set by hand.
# The AP sits on an existing LAN: get the address by DHCP, serve no DHCP.
if [ "$(uci -q get network.lan.proto)" = "static" ] &&
   [ "$(uci -q get network.lan.ipaddr)" = "192.168.1.1" ]; then
	uci -q batch <<"UCI"
set network.lan.proto="dhcp"
delete network.lan.ipaddr
delete network.lan.netmask
delete network.lan.ip6assign
UCI
	uci commit network
fi
/etc/init.d/dnsmasq disable
exit 0
